PORT=3001
HOST=127.0.0.1
WORLD_SEED=econia-genesis-1
POPULATION=64
SIMULATION_INTERVAL_MS=5000
# Without DATABASE_URL, local development uses a durable SQLite database (Node >=22.13).
DATABASE_URL=
ADMIN_TOKEN=
ALLOWED_ORIGINS=
AUTH_RECIPIENT=econia.local
SETTLEMENT_MODE=sandbox
NEAR_RPC_URL=https://rpc.testnet.near.org
ECO_CONTRACT=
WORLD_CONTRACT=
# Only a restricted simulation operator key; never a player's wallet key.
NEAR_OPERATOR_ACCOUNT=
NEAR_OPERATOR_KEY=
NEAR_REGISTRAR_KEY=
# Separate persistence for the commissioned testnet world.
ECONIA_DATA_PATH=
# Explicit rules mode is for reproducible fixtures. Use near-ai for AI operation.
AGENT_MODE=rules
NEAR_AI_API_KEY=
NEAR_AI_MODEL=
NEAR_AI_MAX_TOKENS=1200
AGENT_BATCH_SIZE=4
AGENT_DAILY_CALL_LIMIT=240
